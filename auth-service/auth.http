@baseUrl = http://localhost:8081
@runId = {{$timestamp}}
@readerUsername = reader{{$timestamp}}
@readerEmail = reader{{$timestamp}}@example.com
@readerPassword = password123
@readerNewPassword = newpassword123
@authorUsername = author{{$timestamp}}
@authorEmail = author{{$timestamp}}@example.com
@authorPassword = password123
@adminEmail = admin1@example.com
@adminPassword = password123

### Health Check
GET {{baseUrl}}/auth/test
Accept: application/json

### Register Reader
# @name readerRegister
POST {{baseUrl}}/auth/register
Accept: application/json
Content-Type: application/json

{
  "username": "riddhis",
  "fullName": "riddhi",
  "email": "riddhi22@gmail.com",
  "password": "12345678"
}

### Reader Login
# @name readerLogin
POST {{baseUrl}}/auth/login
Accept: application/json
Content-Type: application/json

{
  "email": "riddhi22@gmail.com",
  "password": "12345678"
}

###
@readerToken = {{readerLogin.response.body.token}}

### Reader Validate Token
GET {{baseUrl}}/auth/validate
Accept: application/json
Authorization: Bearer token

### Reader Profile
GET {{baseUrl}}/auth/profile
Accept: application/json
Authorization: Bearer token

### Reader Update Profile
PUT {{baseUrl}}/auth/profile
Accept: application/json
Authorization: Bearer token
Content-Type: application/json

{
  "username": "{{readerUsername}}",
  "fullName": "Reader One Updated",
  "bio": "I can read, like, comment and subscribe.",
  "avatarUrl": "https://cdn.example.com/avatars/reader1.png"
}

### Reader Change Password
PUT {{baseUrl}}/auth/change-password
Accept: application/json
Authorization: Bearer token
Content-Type: application/json

{
  "oldPassword": "{{readerPassword}}",
  "newPassword": "{{readerNewPassword}}"
}

### Reader Access Check
GET {{baseUrl}}/auth/access/reader
Accept: application/json
Authorization: Bearer token

### Author Access Check With Reader Token - Should Fail
GET {{baseUrl}}/auth/access/author
Accept: application/json
Authorization: Bearer {{readerToken}}

### Admin Access Check With Reader Token - Should Fail
GET {{baseUrl}}/auth/access/admin
Accept: application/json
Authorization: Bearer {{readerToken}}

### Register Author Seed User
# @name authorRegister
POST {{baseUrl}}/auth/register
Accept: application/json
Content-Type: application/json

{
  "username": "{{authorUsername}}",
  "fullName": "Author One",
  "email": "{{authorEmail}}",
  "password": "{{authorPassword}}"
}

### Register Admin Seed User
POST {{baseUrl}}/auth/bootstrap-admin
Accept: application/json
Content-Type: application/json

{
  "username": "admin1",
  "fullName": "Admin One",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Admin Login
# @name adminLogin
POST {{baseUrl}}/auth/login
Accept: application/json
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
@adminToken = {{adminLogin.response.body.token}}

### Promote Author User To AUTHOR
PUT {{baseUrl}}/auth/admin/change-role
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "{{authorEmail}}",
  "role": "AUTHOR"
}

### Promote Admin User To ADMIN
PUT {{baseUrl}}/auth/admin/change-role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "role": "ADMIN"
}

### Author Login After Promotion
# @name authorLogin
POST {{baseUrl}}/auth/login
Accept: application/json
Content-Type: application/json

{
  "email": "{{authorEmail}}",
  "password": "{{authorPassword}}"
}

###
@authorToken = {{authorLogin.response.body.token}}

### Author Access Check
GET {{baseUrl}}/auth/access/author
Accept: application/json
Authorization: Bearer {{authorToken}}

### Admin Access Check
GET {{baseUrl}}/auth/access/admin
Accept: application/json
Authorization: Bearer {{adminToken}}

### List All Users - Admin Only
GET {{baseUrl}}/auth/admin/users
Accept: application/json
Authorization: Bearer {{adminToken}}

### Filter Users By Role - Admin Only
GET {{baseUrl}}/auth/admin/users?role=AUTHOR
Accept: application/json
Authorization: Bearer {{adminToken}}

### Search Users - Admin Only
GET {{baseUrl}}/auth/admin/users/search?keyword=author
Accept: application/json
Authorization: Bearer {{adminToken}}

### Suspend Reader - Admin Only
PUT {{baseUrl}}/auth/admin/users/suspend
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "{{readerEmail}}"
}

### Reactivate Reader - Admin Only
PUT {{baseUrl}}/auth/admin/users/reactivate
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "{{readerEmail}}"
}

### Reader Self Deactivate
PUT {{baseUrl}}/auth/deactivate
Accept: application/json
Authorization: Bearer {{readerToken}}
